---
/**
 * Schematic for "The loop we built" in the-missing-compiler.
 *
 * What the loop is meant to do to the share of drafts experts approve on first
 * review, counting new tickets only (a resubmitted ticket is approved by
 * construction). Each round of grading ends in a nightly run that fixes the
 * request types it exposed, so the rate rises in steps. Common requests get
 * fixed first, so each step is smaller than the last, and the rate levels off
 * below 100%: rare and new kinds of request, the long tail, keep coming. Not
 * measured data, so there are no axis values and no hover layer.
 *
 * A paste into Confluence drops inline SVG, so the Confluence copy of the post
 * shows a PNG of this figure instead. Regenerate it after changing the figure:
 * npm run confluence:figures
 */

const W = 720;
const H = 380;
const plot = { left: 64, right: 600, top: 56, bottom: 312 };

const ROUNDS = 10;
const START = 0.32;
const CEILING = 0.84;
const KEEP = 0.62;
const rate = (k: number) => CEILING - (CEILING - START) * KEEP ** k;

const x = (k: number) => plot.left + (k / ROUNDS) * (plot.right - plot.left);
const y = (r: number) => plot.bottom - r * (plot.bottom - plot.top);

// Flat while a round is graded, then up when its nightly run ships.
const steps = Array.from({ length: ROUNDS }, (_, k) => [
  `${x(k)},${y(rate(k))}`,
  `${x(k + 1)},${y(rate(k))}`,
  ...(k + 1 < ROUNDS ? [`${x(k + 1)},${y(rate(k + 1))}`] : []),
]).flat();

const tailX = x(ROUNDS - 1.4);
const lastY = y(rate(ROUNDS - 1));

const title = 'First-pass approval rate on new tickets, round after round of grading';
const desc =
  'Schematic of what the loop is meant to do, not measured. The share of drafts for new tickets that experts ' +
  'approve on first review stays flat while a round of drafts is graded and rises when the nightly run ships the ' +
  'fixes that round exposed. Common requests get fixed first, so each step is smaller than the last, and the rate ' +
  'levels off below 100%: the long tail of rare and new requests stays.';
---

{Astro.locals.confluence ? (
  <img src="/images/blog/the-missing-compiler/approval-curve.png" alt={`${title}. ${desc}`} />
) : (
  <figure class="approval-curve not-prose my-8">
    <div class="scroll">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="approval-curve-title approval-curve-desc">
        <title id="approval-curve-title">{title}</title>
        <desc id="approval-curve-desc">{desc}</desc>

        <rect class="tail" x={plot.left} y={y(1)} width={plot.right - plot.left} height={lastY - y(1)} />

        <line class="axis" x1={plot.left} y1={plot.bottom} x2={plot.right} y2={plot.bottom} />
        <line class="axis" x1={plot.left} y1={plot.bottom} x2={plot.left} y2={plot.top - 16} />
        <line class="ceiling" x1={plot.left} y1={y(1)} x2={plot.right} y2={y(1)} />
        <text class="label" x={plot.right + 10} y={y(1) + 5}>100%</text>

        <polyline class="series" points={steps.join(' ')} />
        <text class="label strong" x={plot.right + 10} y={lastY + 5}>New tickets</text>

        {Array.from({ length: ROUNDS - 1 }, (_, k) => (
          <circle class="night" cx={x(k + 1)} cy={y(rate(k + 1))} r="4" />
        ))}
        <text class="note" x={x(1) + 10} y={y(rate(1)) + 24}>Nightly run ships the round's fixes</text>

        <text class="note" x={tailX} y={(y(1) + lastY) / 2 + 5} text-anchor="middle">Long tail</text>

        <text class="axis-title" transform={`translate(${plot.left - 18},${(plot.top + plot.bottom) / 2}) rotate(-90)`} text-anchor="middle">
          Approved on first review
        </text>
        <text class="tick" x={plot.left} y={plot.bottom + 20} text-anchor="middle">Shadow start</text>
        <text class="tick" x={plot.right} y={plot.bottom + 20} text-anchor="end">Rounds of grading →</text>
      </svg>
    </div>
  </figure>
)}

<style>
  /* The palette of the post's other figures (loop-animation.css). */
  .approval-curve {
    --text-primary: #1f2937;
    --text-secondary: #6b7280;
    --axis: #cbd5e1;
    --line: #2563eb;
    --surface: #ffffff;
    --tail: #e76f51;
  }
  :global(.dark) .approval-curve {
    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --axis: #374151;
    --line: #5b9cea;
    --surface: #111827;
    --tail: #ee8466;
  }

  /* Without containment the chart's min-width below would widen the post's
     column instead of scrolling inside it. */
  .approval-curve {
    container-type: inline-size;
  }

  .scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 540px;
    height: auto;
    font-family: inherit;
  }

  .axis {
    stroke: var(--axis);
    stroke-width: 1;
    fill: none;
  }
  .ceiling {
    stroke: var(--text-secondary);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .tail {
    fill: var(--tail);
    opacity: 0.1;
  }
  .series {
    fill: none;
    stroke: var(--line);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .night {
    fill: var(--line);
    stroke: var(--surface);
    stroke-width: 2;
  }

  text {
    font-size: 15px;
    fill: var(--text-secondary);
  }
  .strong {
    fill: var(--text-primary);
    font-weight: 600;
  }
  .axis-title,
  .tick {
    font-size: 14px;
  }
</style>
