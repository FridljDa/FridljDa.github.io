---
/**
 * One of the step figures of first-level-support-automation (see
 * PipelineFigures.tsx). Rendered on the server, no JavaScript.
 */
import { FIGURES, type FigureName } from './PipelineFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const { component: Figure, description, width } = FIGURES[name];
---

<figure class="pipeline-figure lv-theme not-prose my-8" data-figure={name}>
  <div class="frame" style={`max-width: ${width}px`}>
    <Figure />
  </div>
</figure>

<style>
  .pipeline-figure .frame {
    margin: 0 auto;
  }
</style>
