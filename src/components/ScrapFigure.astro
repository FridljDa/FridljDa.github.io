---
/**
 * One of the figures of scrap-conditional-independence (see ScrapFigures.tsx).
 * Rendered on the server, no JavaScript.
 */
import { FIGURES, type FigureName } from './ScrapFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const { component: Figure, description, width } = FIGURES[name];
---

<figure class="scrap-figure lv-theme not-prose my-8" data-figure={name}>
  <div class="frame" style={`max-width: ${width}px`}>
    <Figure />
  </div>
</figure>

<style>
  .scrap-figure .frame {
    margin: 0 auto;
  }
</style>
