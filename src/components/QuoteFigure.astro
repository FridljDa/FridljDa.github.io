---
/**
 * One of the figures of from-drawing-to-quote (see
 * QuoteFigures.tsx). Rendered on the server, no JavaScript.
 */
import QuoteFigureSvg, { DESCRIPTIONS, type FigureName } from './QuoteFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const description = DESCRIPTIONS[name];
---

<figure class="quote-figure lv-theme not-prose my-8" data-figure={name}>
  <div class="frame">
    <QuoteFigureSvg name={name} id={name} />
  </div>
</figure>

<style>
  .quote-figure .frame {
    max-width: 520px;
    margin: 0 auto;
  }
  .quote-figure :global(svg) {
    display: block;
  }
</style>
