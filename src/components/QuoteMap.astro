---
/**
 * The section map of from-drawing-to-quote, at the level of
 * detail and with the part highlighted that the section is about (see
 * QuoteMap.tsx for the presets). Rendered on the server, no JavaScript.
 */
import QuoteMapSvg, { PRESETS, type PresetName } from './QuoteMap';
import './loop-animation.css';

interface Props {
  preset: PresetName;
}

const { preset } = Astro.props;
const { description } = PRESETS[preset];
---

<figure class="quote-map lv-theme not-prose my-8" data-figure={`map-${preset}`}>
  <div class="frame">
    <QuoteMapSvg preset={preset} id={`map-${preset}`} />
  </div>
</figure>

<style>
  /* One vertical layout for every width; on wide screens it would otherwise
     fill the column and tower over the text. */
  .quote-map .frame {
    max-width: 480px;
    margin: 0 auto;
  }
  .quote-map :global(svg) {
    display: block;
  }
</style>
