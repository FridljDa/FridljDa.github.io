---
/**
 * One of the figures of uncoded-hospital-revenue (see
 * DesignFigures.tsx). Rendered on the server, no JavaScript.
 *
 * A paste into Confluence drops inline SVG, so the Confluence copy shows a PNG
 * of the figure, <name>.png in the post's image folder. Regenerate them after
 * changing a figure: npm run confluence:figures
 */
import DesignFigureSvg, { DESCRIPTIONS, type FigureName } from './DesignFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const description = DESCRIPTIONS[name];
const png = `/images/blog/${Astro.params.slug}/${name}.png`;
---

{Astro.locals.confluence ? (
  <img src={png} alt={description} />
) : (
  <figure class="design-figure not-prose my-8" data-confluence-png={png}>
    <div class="frame">
      <DesignFigureSvg name={name} id={name} />
    </div>
  </figure>
)}

<style>
  .design-figure .frame {
    max-width: 520px;
    margin: 0 auto;
  }
  .design-figure :global(svg) {
    display: block;
  }
</style>
