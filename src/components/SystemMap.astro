---
/**
 * The system map of the-missing-test-suite, with one section's part highlighted
 * (see SystemMap.tsx for the presets). Rendered on the server, no JavaScript.
 */
import SystemMapSvg, { PRESETS, type Preset, type PresetName } from './SystemMap';
import './loop-animation.css';

interface Props {
  preset: PresetName;
}

const { preset } = Astro.props;
const { description, small }: Preset = PRESETS[preset];
---

<figure class:list={['system-map lv-theme not-prose my-8', { small }]} data-figure={`map-${preset}`}>
  <div class="frame">
    <SystemMapSvg preset={preset} id={`map-${preset}`} />
  </div>
</figure>

<style>
  /* The wide map's labels get too small below this width, so phones (and
     narrow columns) get the two-column layout instead. */
  .system-map {
    container-type: inline-size;
  }
  .system-map :global(svg) {
    display: block;
  }
  .system-map :global(.map-tall) {
    display: none;
  }
  /* A map that only shows where a section sits is drawn smaller. */
  :global(.prose) .system-map.small .frame {
    max-width: 440px;
    margin: 0 auto;
  }
  @container (max-width: 560px) {
    .system-map :global(.map-wide) {
      display: none;
    }
    .system-map :global(.map-tall) {
      display: block;
      max-width: 520px;
      margin: 0 auto;
    }
  }
</style>
