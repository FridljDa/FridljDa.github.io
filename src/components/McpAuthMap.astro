---
/**
 * The section map of mcp-server-authorization, with one section's part highlighted
 * (see McpAuthMap.tsx for the presets). Rendered on the server, no JavaScript.
 *
 * A paste into Confluence drops inline SVG, so the Confluence copy shows a PNG
 * of each preset, map-<preset>.png in the post's image folder. Regenerate them
 * after changing the map: npm run confluence:figures
 */
import McpAuthMapSvg, { PRESETS, type PresetName } from './McpAuthMap';
import './loop-animation.css';

interface Props {
  preset: PresetName;
}

const { preset } = Astro.props;
const { description } = PRESETS[preset];
const png = `/images/blog/${Astro.params.slug}/map-${preset}.png`;
---

{Astro.locals.confluence ? (
  <img src={png} alt={description} />
) : (
  <figure class="mcp-auth-map lv-theme not-prose my-8" data-confluence-png={png}>
    <div class="frame">
      <McpAuthMapSvg preset={preset} id={`map-${preset}`} />
    </div>
  </figure>
)}

<style>
  /* One vertical layout for every width. */
  .mcp-auth-map .frame {
    max-width: 480px;
    margin: 0 auto;
  }
  .mcp-auth-map :global(svg) {
    display: block;
  }
</style>
