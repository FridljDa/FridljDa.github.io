---
/**
 * One of the figures of workflow-vs-agent (see DecisionFigures.tsx). Rendered
 * on the server, no JavaScript.
 *
 * A paste into Confluence drops inline SVG, so the Confluence copy shows a PNG
 * of the figure, <name>.png in the post's image folder. Regenerate them after
 * changing a figure: npm run confluence:figures
 */
import { FIGURES, type FigureName } from './DecisionFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const { component: Figure, description, width } = FIGURES[name];
const png = `/images/blog/${Astro.params.slug}/${name}.png`;
---

{Astro.locals.confluence ? (
  <img src={png} alt={description} />
) : (
  <figure class="decision-figure lv-theme not-prose my-8" data-confluence-png={png}>
    <div class="frame" style={`--width: ${width}px`}>
      <Figure />
    </div>
  </figure>
)}

<style>
  /* As in DecisionMap.astro: in a narrow column the wide layout's type gets
     too small, so phones get the figure's narrower layout instead. */
  .decision-figure {
    container-type: inline-size;
  }
  .decision-figure .frame {
    max-width: var(--width);
    margin: 0 auto;
  }
  .decision-figure :global(svg) {
    display: block;
  }
  .decision-figure :global(.figure-tall) {
    display: none;
  }
  @container (max-width: 560px) {
    .decision-figure .frame {
      max-width: 460px;
    }
    .decision-figure :global(.figure-wide) {
      display: none;
    }
    .decision-figure :global(.figure-tall) {
      display: block;
    }
  }
</style>
