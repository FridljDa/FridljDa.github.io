---
/**
 * One of the figures of api-keys-oauth-jwt (see
 * AuthFigures.tsx). Rendered on the server, no JavaScript.
 */
import AuthFigureSvg, { DESCRIPTIONS, type FigureName } from './AuthFigures';
import './loop-animation.css';

interface Props {
  name: FigureName;
}

const { name } = Astro.props;
const description = DESCRIPTIONS[name];
---

<figure class="auth-figure lv-theme not-prose my-8" data-figure={name}>
  <div class="frame">
    <AuthFigureSvg name={name} id={name} />
  </div>
</figure>

<style>
  .auth-figure .frame {
    max-width: 520px;
    margin: 0 auto;
  }
  .auth-figure :global(svg) {
    display: block;
  }
</style>
