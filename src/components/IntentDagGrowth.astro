---
/**
 * How the intent DAG in "Step 1: Intent recognition" of
 * first-level-support-automation grew with subject-matter expert feedback.
 *
 * Starts from the intents clustered out of historical tickets and adds one
 * change per round of feedback, ending on the DAG drawn earlier in the step.
 * Nodes never move: every later node already has its slot, so a round only
 * fades in a node or draws in an edge. The animation plays once, when the
 * figure scrolls into view, and stops on the full DAG; Replay runs it again.
 *
 * Without JavaScript, with prefers-reduced-motion, and in the Confluence PNG
 * the figure shows the full DAG, with numbered badges tying each added part to
 * its round in the legend.
 *
 * A paste into Confluence drops inline SVG, so the Confluence copy of the post
 * shows a PNG of this figure instead. Regenerate it after changing the figure:
 * npm run confluence:figures
 */

type Kind = 'root' | 'intent' | 'other';

interface Node {
  label: string[];
  kind: Kind;
  x: number;
  y: number;
  w: number;
  h: number;
  /** The feedback round that added it; base intents have none. */
  round?: number;
}

const ROUNDS = [
  { when: 'Launch', what: 'Intents from clustered historical tickets' },
  { when: 'Round 1', what: 'Experts flag password resets landing in Other: new leaf' },
  { when: 'Round 2', what: 'Same for locked accounts' },
  { when: 'Round 3', what: 'Card-PIN lockouts need the same unlock flow: a second parent makes it a DAG' },
];

const NODE_H = 34;
const row = (i: number) => 25 + 46 * i;
const col = {
  root: { x: 4, w: 96 },
  parent: { x: 160, w: 128 },
  leaf: { x: 348, w: 132 },
};

const parent = (label: string, y: number, kind: Kind = 'intent'): Node => ({
  label: [label],
  kind,
  ...col.parent,
  y,
  h: NODE_H,
});
const leaf = (label: string, i: number, kind: Kind = 'intent', round?: number): Node => ({
  label: [label],
  kind,
  ...col.leaf,
  y: row(i),
  h: NODE_H,
  round,
});

// Parents sit level with the middle of their leaves. The shared leaf sits
// between its two parents, so both edges into it are short.
const parents = {
  access: parent('Account access', (row(0) + row(3)) / 2),
  cards: parent('Card services', (row(3) + row(5)) / 2),
  payments: parent('Payments', row(6)),
  rootOther: parent('Other', row(7), 'other'),
};
const nodes = {
  root: {
    label: ['Customer', 'message'],
    kind: 'root',
    ...col.root,
    y: (parents.access.y + parents.rootOther.y) / 2,
    h: 48,
  },
  ...parents,
  login: leaf('Login problem', 0),
  reset: leaf('Password reset', 1, 'intent', 1),
  accessOther: leaf('Other', 2, 'other'),
  locked: leaf('Account locked', 3, 'intent', 2),
  blocked: leaf('Card blocked', 4),
  cardsOther: leaf('Other', 5, 'other'),
} satisfies Record<string, Node>;

type Id = keyof typeof nodes;

const EDGES: { from: Id; to: Id; round?: number }[] = [
  { from: 'root', to: 'access' },
  { from: 'root', to: 'cards' },
  { from: 'root', to: 'payments' },
  { from: 'root', to: 'rootOther' },
  { from: 'access', to: 'login' },
  { from: 'access', to: 'reset', round: 1 },
  { from: 'access', to: 'accessOther' },
  { from: 'access', to: 'locked', round: 2 },
  { from: 'cards', to: 'locked', round: 3 },
  { from: 'cards', to: 'blocked' },
  { from: 'cards', to: 'cardsOther' },
];

const edges = EDGES.map(({ from, to, round }) => {
  const a = nodes[from];
  const b = nodes[to];
  const [x1, y1, x2, y2] = [a.x + a.w, a.y, b.x, b.y];
  const mx = (x1 + x2) / 2;
  // With both control points at the horizontal midpoint, the curve's midpoint
  // is the chord's, which is where an edge's badge goes.
  return { d: `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`, round, mid: { x: mx, y: (y1 + y2) / 2 } };
});

// A round that adds a node is badged beside it; one that only adds an edge, on the edge.
const BADGE_R = 10;
const badges = ROUNDS.slice(1).map((_, i) => {
  const round = i + 1;
  const node = Object.values(nodes).find((n: Node) => n.round === round);
  if (node) return { round, x: node.x + node.w + BADGE_R + 8, y: node.y };
  return { round, ...edges.find((e) => e.round === round)!.mid };
});

const W = col.leaf.x + col.leaf.w + 2 * BADGE_R + 16;
const H = row(7) + NODE_H / 2 + 8;

const title = 'How subject-matter expert feedback grew the intent DAG';
const desc =
  'At launch, a customer message branches into Account access (Login problem, Other), Card services ' +
  '(Card blocked, Other), Payments and Other. Round 1 of expert feedback adds Password reset under Account ' +
  'access. Round 2 adds Account locked under Account access. Round 3 also connects Card services to Account ' +
  'locked, so that leaf has two parents and the tree becomes a DAG.';
const png = '/images/blog/first-level-support-automation/intent-dag-growth.png';
---

{Astro.locals.confluence ? (
  <img src={png} alt={`${title}. ${desc}`} />
) : (
  <figure class="intent-dag-growth not-prose my-8" data-confluence-png={png}>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="intent-dag-growth-title intent-dag-growth-desc">
      <title id="intent-dag-growth-title">{title}</title>
      <desc id="intent-dag-growth-desc">{desc}</desc>

      {edges.map((edge) => (
        <path
          class:list={['edge', { added: edge.round }]}
          d={edge.d}
          pathLength="1"
          data-round={edge.round}
        />
      ))}

      {Object.values(nodes).map((node: Node) => (
        <g class:list={['node', node.kind, { added: node.round }]} data-round={node.round}>
          <rect
            x={node.x}
            y={node.y - node.h / 2}
            width={node.w}
            height={node.h}
            rx={node.kind === 'root' ? node.h / 2 : 8}
          />
          <text x={node.x + node.w / 2} y={node.y} text-anchor="middle">
            {node.label.map((line, i) => (
              <tspan x={node.x + node.w / 2} dy={i === 0 ? `${0.35 - (node.label.length - 1) * 0.6}em` : '1.2em'}>
                {line}
              </tspan>
            ))}
          </text>
        </g>
      ))}

      {badges.map((badge) => (
        <g class="badge added" data-round={badge.round}>
          <circle cx={badge.x} cy={badge.y} r={BADGE_R} />
          <text x={badge.x} y={badge.y} dy="0.35em" text-anchor="middle">{badge.round}</text>
        </g>
      ))}
    </svg>

    <ol class="rounds" role="list">
      {ROUNDS.map((round, i) => (
        <li data-round={i}>
          <span class:list={['marker', { start: i === 0 }]} aria-hidden="true">{i || ''}</span>
          <span class="when">{round.when}</span>
          <span class="what">{round.what}</span>
        </li>
      ))}
    </ol>

    <button type="button" class="replay">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v5h-5" /></svg>
      Replay
    </button>
  </figure>
)}

<script>
  const START_MS = 1000;
  const STEP_MS = 2600;

  for (const figure of document.querySelectorAll<HTMLElement>('.intent-dag-growth')) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const parts = [...figure.querySelectorAll<HTMLElement | SVGElement>('[data-round]')];
    const roundOf = (el: HTMLElement | SVGElement) => Number(el.dataset.round);
    const last = Math.max(...parts.map(roundOf));
    let timers: number[] = [];

    // null is the resting state: everything shown, no round singled out.
    const show = (step: number | null) => {
      for (const el of parts) {
        el.classList.toggle('pending', step !== null && roundOf(el) > step);
        el.classList.toggle('current', step === roundOf(el));
      }
    };

    const play = () => {
      timers.forEach(clearTimeout);
      show(0);
      timers = [
        ...Array.from({ length: last }, (_, i) => window.setTimeout(() => show(i + 1), START_MS + i * STEP_MS)),
        window.setTimeout(() => show(null), START_MS + last * STEP_MS),
      ];
    };

    // Rewind before the reader gets there, without fading out what they never saw.
    figure.classList.add('animated', 'instant');
    show(0);
    figure.getBoundingClientRect();
    figure.classList.remove('instant');

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        play();
      },
      { threshold: 0.6 }
    );
    observer.observe(figure);

    figure.querySelector('.replay')!.addEventListener('click', play);
  }
</script>

<style>
  .intent-dag-growth {
    --text-primary: #1f2937;
    --text-secondary: #4b5563;
    --edge: #94a3b8;
    --node-bg: #f8fafc;
    --node-border: #64748b;
    --other-bg: #fff7ed;
    --other: #ea580c;
    --added-bg: #dbeafe;
    --added: #2563eb;
    --surface: #ffffff;
    container-type: inline-size;
  }
  :global(.dark) .intent-dag-growth {
    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --edge: #4b5563;
    --node-bg: #1f2937;
    --node-border: #6b7280;
    --other-bg: #2a1c12;
    --other: #f97316;
    --added-bg: #172338;
    --added: #5b9cea;
    --surface: #111827;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: 0 auto;
    font-family: inherit;
  }

  .edge {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.5;
  }
  .edge.added {
    stroke: var(--added);
    stroke-width: 2;
  }

  .node rect {
    fill: var(--node-bg);
    stroke: var(--node-border);
    stroke-width: 1.5;
  }
  .node.other rect {
    fill: var(--other-bg);
    stroke: var(--other);
    stroke-dasharray: 4 3;
  }
  .node.added rect {
    fill: var(--added-bg);
    stroke: var(--added);
    stroke-width: 2;
  }
  .node text {
    font-size: 15px;
    fill: var(--text-primary);
  }

  .badge circle {
    fill: var(--added);
  }
  .badge text {
    font-size: 12px;
    font-weight: 700;
    fill: var(--surface);
  }

  /* Legend: one round per row on phones, a timeline of four on wider screens. */
  .rounds {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .rounds li {
    position: relative;
    display: grid;
    grid-template-columns: 1.375rem minmax(0, 1fr);
    column-gap: 0.625rem;
    row-gap: 0.125rem;
  }
  .marker {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--surface);
    background: var(--added);
  }
  .marker.start {
    background: var(--surface);
    border: 2px solid var(--node-border);
  }
  .when {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .what {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  @container (min-width: 560px) {
    .rounds {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
    .rounds li {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      justify-items: start;
      row-gap: 0.25rem;
    }
    .marker {
      grid-row: auto;
      margin-bottom: 0.25rem;
    }
    .when {
      line-height: 1rem;
    }
    /* Rail from this round's marker to the next one's. */
    .rounds li:not(:last-child)::before {
      content: '';
      position: absolute;
      top: calc(0.6875rem - 1px);
      left: calc(1.375rem + 0.375rem);
      right: calc(0.375rem - 1rem);
      height: 2px;
      background: var(--edge);
      opacity: 0.6;
    }
  }

  .replay {
    display: none;
    align-items: center;
    gap: 0.375rem;
    margin: 0.75rem 0 0 auto;
    padding: 0.25rem 0.5rem;
    border: 0;
    border-radius: 6px;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: none;
    cursor: pointer;
  }
  .replay:hover {
    color: var(--text-primary);
  }
  .replay:focus-visible {
    outline: 2px solid var(--added);
    outline-offset: 2px;
  }
  .replay svg {
    width: 1rem;
    height: 1rem;
    margin: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /*
   * Animation, only once the script has taken over. A round draws its edge in,
   * then fades its node and badge in; a replay clears them quickly.
   */
  .animated .replay {
    display: flex;
  }
  .animated .edge.added {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 700ms ease-in-out;
  }
  .animated .added:is(.node, .badge) {
    transition: opacity 500ms ease 450ms;
  }
  .animated .rounds li {
    transition: opacity 400ms ease;
  }
  .animated .edge.added.pending {
    stroke-dashoffset: 1;
    transition-duration: 250ms;
  }
  .animated .added.pending:is(.node, .badge) {
    opacity: 0;
    transition-duration: 250ms;
    transition-delay: 0s;
  }
  .animated .rounds li.pending {
    opacity: 0.35;
  }
  .rounds li.current .marker {
    outline: 2px solid var(--added);
    outline-offset: 2px;
  }
  .rounds li.current .marker.start {
    outline-color: var(--node-border);
  }
  .instant,
  .instant * {
    transition: none !important;
  }
</style>
